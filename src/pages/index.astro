---
/**
 * Accueil : vidéo du club, matchs de la semaine, équipes, appel à rejoindre le club.
 * Les partenaires défilent dans le bandeau commun, au-dessus du pied de page.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Bandeau from '../components/ui/Bandeau.astro';
import Bouton from '../components/ui/Bouton.astro';
import TitreSection from '../components/ui/TitreSection.astro';
import TraitsTerrain from '../components/ui/TraitsTerrain.astro';
import Scorenco from '../components/Scorenco.astro';
import GrilleEquipes from '../components/GrilleEquipes.astro';
import { getEquipes } from '../lib/equipes';
import { site } from '../config/site';

const equipes = await getEquipes();
const video = site.videoAccueil;
---

<BaseLayout titre="Club de handball de La Bruffière">
  <Bandeau
    titre="Le handball à La Bruffière, pour toute la famille"
    intro="Du baby hand aux seniors, des équipes pour tous les âges et tous les niveaux, à la salle de La Bruffière."
    video={video}
    anime
  >
    <Fragment slot="actions">
      <Bouton href="#equipes">Trouver mon équipe</Bouton>
      <Bouton href="/matchs/" variante={video ? 'contour-inverse' : 'secondaire'}>Voir les matchs</Bouton>
    </Fragment>
  </Bandeau>

  <section class="section section--alterne" aria-labelledby="matchs">
    <div class="conteneur">
      <TitreSection id="matchs" titre="Matchs de la semaine" lien={{ href: '/matchs/', label: 'Tous les matchs' }} />
      <Scorenco
        embed={{ widget: '4994', type: 'week-events' }}
        titre="Matchs de la semaine"
        secours={{ href: '/matchs/', label: 'Voir tous les matchs du club' }}
        hauteur="18rem"
      />
    </div>
  </section>

  <section class="section conteneur" aria-labelledby="equipes">
    <TitreSection
      id="equipes"
      titre="Nos équipes"
      intro="Du baby hand dès 3 ans jusqu'aux seniors et au loisir."
      lien={{ href: '/entrainement/', label: "Horaires d'entraînement" }}
    />
    <GrilleEquipes equipes={equipes} />
  </section>

  <section class="rejoindre" aria-labelledby="rejoindre">
    <div class="conteneur rejoindre__grille">
      <div>
        <h2 id="rejoindre">Envie de jouer avec nous ?</h2>
        <p>
          Débutant ou confirmé, venez découvrir le handball lors d'un entraînement de votre catégorie, puis prenez votre licence en
          ligne.
        </p>
        <div class="rejoindre__actions">
          <Bouton href="/licences/" variante="inverse">Prendre une licence</Bouton>
          <Bouton href="/entrainement/" variante="contour-inverse">Voir les horaires</Bouton>
        </div>
      </div>
      <div class="rejoindre__terrain" aria-hidden="true">
        <TraitsTerrain couleur="blanc" />
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .rejoindre {
    overflow: hidden;
    background: var(--rouge);
    color: var(--blanc);
  }

  .rejoindre__grille {
    display: grid;
    gap: var(--espace-5);
    align-items: end;
    padding-top: var(--espace-section);
  }

  @media (min-width: 60rem) {
    .rejoindre__grille {
      grid-template-columns: 3fr 2fr;
    }
  }

  .rejoindre h2 {
    color: var(--blanc);
  }

  .rejoindre p {
    font-size: var(--taille-lg);
  }

  .rejoindre__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espace-3);
    margin: var(--espace-6) 0 var(--espace-section);
  }

  .rejoindre__terrain {
    width: min(100%, 26rem);
    justify-self: end;
    opacity: 0.6;
  }
</style>
