---
/**
 * Pages de contenu en Markdown (src/content/pages/*.md).
 * Le nom du fichier donne l'adresse : mentions-legales.md → /mentions-legales/
 */
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

export const getStaticPaths = (async () => {
  const pages = await getCollection('pages');
  return pages.map((page) => ({
    params: { page: page.id },
    props: { page },
  }));
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const { Content } = await render(page);
---

<BaseLayout titre={page.data.titre} description={page.data.description}>
  <article class="conteneur contenu">
    <h1>{page.data.titre}</h1>
    <Content />
  </article>
</BaseLayout>

<style>
  .contenu {
    padding-block: var(--espace-section);
    max-width: 48rem;
  }

  .contenu :global(h2) {
    margin-top: var(--espace-7);
  }

  /* Les titres de niveau 3 servent aux dates (page Histoire) : style tableau de score. */
  .contenu :global(h3) {
    margin: var(--espace-6) 0 var(--espace-2);
    padding-top: var(--espace-4);
    border-top: var(--trait);
    font-family: var(--police-titre);
    font-size: 2rem;
    font-weight: var(--graisse-titre);
    color: var(--rouge-fonce);
    font-variant-numeric: tabular-nums;
  }

  .contenu :global(ol),
  .contenu :global(ul) {
    padding-left: 1.4em;
  }

  .contenu :global(li) {
    margin-bottom: var(--espace-2);
  }

  .contenu :global(li > ul) {
    margin-top: var(--espace-2);
  }
</style>
