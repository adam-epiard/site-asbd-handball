---
/**
 * Contact : formulaire (envoyé par public/api/formulaire.php) et coordonnées directes.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import TitreSection from '../components/ui/TitreSection.astro';
import Formulaire from '../components/Formulaire.astro';
import Champ from '../components/ui/Champ.astro';
import { site } from '../config/site';

const { adresse, email, emailLicences, reseaux } = site;
---

<BaseLayout
  titre="Contact"
  description="Contacter l'ASBD Vendée Handball : e-mail du club, adresse de la salle à La Bruffière, réseaux sociaux et licences."
>
  <section class="section conteneur">
    <TitreSection niveau="h1" titre="Contacter le club" intro="Une question sur une équipe, un essai ou un partenariat ? Écrivez-nous." />
    <div class="mise-en-page">
      <Formulaire nom="contact" bouton="Envoyer le message" succes="Le club vous répond par e-mail dans les prochains jours.">
        <Champ nom="nom" label="Votre nom" autocomplete="name" maxlength={100} />
        <Champ nom="email" label="Votre e-mail" type="email" autocomplete="email" maxlength={254} />
        <Champ nom="objet" label="Objet" maxlength={150} aide="Par exemple : essai pour mon enfant, question sur une équipe." />
        <Champ nom="message" label="Votre message" type="textarea" maxlength={5000} />
      </Formulaire>

    <div class="contacts">
      {
        email && (
          <div class="contact">
            <h2>Par e-mail</h2>
            <p>
              <a href={`mailto:${email}`}>{email}</a>
            </p>
          </div>
        )
      }
      <div class="contact">
        <h2>À la salle</h2>
        <address>
          {adresse.rue}<br />
          {adresse.codePostal} {adresse.ville}
        </address>
        <p><a href="/ou-nous-trouver/">Plan d'accès</a> · <a href="/entrainement/">Horaires d'entraînement</a></p>
      </div>
      {
        emailLicences && (
          <div class="contact">
            <h2>Licences</h2>
            <p>
              Pour prendre une licence, écrivez à <a href={`mailto:${emailLicences}`}>{emailLicences}</a>.
            </p>
            <p><a href="/licences/">Voir les étapes</a></p>
          </div>
        )
      }
      {
        (reseaux.instagram || reseaux.facebook) && (
          <div class="contact">
            <h2>Sur les réseaux</h2>
            <ul>
              {reseaux.instagram && (
                <li>
                  <a href={reseaux.instagram} rel="noopener">Instagram</a>
                </li>
              )}
              {reseaux.facebook && (
                <li>
                  <a href={reseaux.facebook} rel="noopener">Facebook</a>
                </li>
              )}
            </ul>
          </div>
        )
      }
    </div>
    </div>
  </section>
</BaseLayout>

<style>
  .mise-en-page {
    display: grid;
    gap: var(--espace-7);
  }

  @media (min-width: 64rem) {
    .mise-en-page {
      grid-template-columns: 3fr 2fr;
      align-items: start;
    }
  }

  .contacts {
    display: grid;
    gap: var(--espace-4);
  }

  .contact {
    padding: var(--espace-5);
    border: var(--trait);
    border-radius: var(--rayon);
  }

  .contact h2 {
    font-size: 1.75rem;
  }

  address {
    font-style: normal;
    margin-bottom: var(--espace-4);
  }

  .contact ul {
    padding-left: 1.2em;
  }
</style>
