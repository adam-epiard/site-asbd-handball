---
/**
 * Pied de page : coordonnées du club et liens utiles, sur fond noir.
 * Un champ vide dans src/config/site.ts n'affiche rien.
 */
import { site } from '../config/site';

const annee = new Date().getFullYear();
const { adresse, email, reseaux } = site;
---

<footer class="pied">
  <div class="conteneur pied__grille">
    <div>
      <p class="pied__nom">{site.nom}</p>
      <address class="pied__adresse">
        {adresse.rue}<br />
        {adresse.codePostal} {adresse.ville}
      </address>
      {email && <p><a href={`mailto:${email}`}>{email}</a></p>}
    </div>

    {
      (reseaux.instagram || reseaux.facebook) && (
        <div>
          <p class="pied__titre">Suivre le club</p>
          <ul class="pied__liens">
            {reseaux.instagram && (
              <li>
                <a href={reseaux.instagram} rel="noopener">Instagram</a>
              </li>
            )}
            {reseaux.facebook && (
              <li>
                <a href={reseaux.facebook} rel="noopener">Facebook</a>
              </li>
            )}
          </ul>
        </div>
      )
    }

    <div>
      <p class="pied__titre">Infos pratiques</p>
      <ul class="pied__liens">
        <li><a href="/contact/">Contacter le club</a></li>
        <li><a href="/licences/">Prendre une licence</a></li>
        <li><a href="/mentions-legales/">Mentions légales</a></li>
      </ul>
    </div>
  </div>
  <p class="conteneur pied__copyright">© {annee} {site.nom}</p>
</footer>

<style>
  .pied {
    margin-top: auto;
    padding-block: var(--espace-7) var(--espace-4);
    background: var(--noir);
    color: #cfcfcf;
    font-size: var(--taille-sm);
  }

  .pied a {
    color: var(--blanc);
  }

  .pied__grille {
    display: grid;
    gap: var(--espace-6);
  }

  @media (min-width: 40rem) {
    .pied__grille {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }

  .pied__nom {
    margin: 0 0 var(--espace-3);
    font-family: var(--police-titre);
    font-size: 1.75rem;
    font-weight: var(--graisse-titre);
    line-height: 1;
    color: var(--blanc);
  }

  .pied__titre {
    margin: 0 0 var(--espace-3);
    font-weight: var(--graisse-gras);
    color: var(--blanc);
  }

  .pied__adresse {
    font-style: normal;
  }

  .pied__liens {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--espace-2);
  }

  .pied__copyright {
    margin-top: var(--espace-7);
    padding-top: var(--espace-4);
    border-top: 1px solid #333333;
    font-size: var(--taille-xs);
  }
</style>
