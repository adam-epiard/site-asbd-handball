---
/**
 * Carte d'une équipe : photo, nom, catégorie, niveau.
 * Toute la carte est cliquable (le lien est sur le nom).
 * Sans photo, la carte affiche le motif du terrain au lieu d'un texte d'attente.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import TraitsTerrain from './TraitsTerrain.astro';
import Etiquette from './Etiquette.astro';

interface Props {
  nom: string;
  href: string;
  categorie?: string;
  niveau?: string;
  photo?: { src: ImageMetadata; alt: string };
}

const { nom, href, categorie, niveau, photo } = Astro.props;
---

<article class="carte-equipe">
  <div class="carte-equipe__visuel">
    {
      photo ? (
        <Image
          src={photo.src}
          alt={photo.alt}
          widths={[400, 800]}
          sizes="(min-width: 60rem) 25vw, (min-width: 40rem) 50vw, 100vw"
          class="carte-equipe__photo"
        />
      ) : (
        <TraitsTerrain couleur="ligne" class="carte-equipe__terrain" />
      )
    }
  </div>
  <div class="carte-equipe__corps">
    <h3 class="carte-equipe__nom">
      <a href={href}>{nom}</a>
    </h3>
    {
      (categorie || niveau) && (
        <p class="carte-equipe__infos">
          {categorie && <Etiquette>{categorie}</Etiquette>}
          {niveau && <span>{niveau}</span>}
        </p>
      )
    }
  </div>
</article>

<style>
  .carte-equipe {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--blanc);
    border: var(--trait);
    border-radius: var(--rayon);
    overflow: hidden;
    transition: border-color var(--duree) var(--courbe);
  }

  .carte-equipe:hover {
    border-color: var(--noir);
  }

  .carte-equipe:focus-within {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }

  .carte-equipe__visuel {
    aspect-ratio: 4 / 3;
    background: var(--gris-salle);
    display: flex;
    align-items: flex-end;
  }

  .carte-equipe__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .carte-equipe__terrain {
    width: 85%;
    margin-inline: auto;
  }

  .carte-equipe__corps {
    padding: var(--espace-4) var(--espace-4) var(--espace-5);
  }

  .carte-equipe__nom {
    margin: 0;
    font-family: var(--police-titre);
    font-size: 1.75rem;
    font-weight: var(--graisse-titre);
    line-height: 1.05;
  }

  .carte-equipe__nom a {
    color: var(--noir);
    text-decoration: none;
  }

  /* Le lien couvre toute la carte. */
  .carte-equipe__nom a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .carte-equipe__nom a:focus-visible {
    outline: none;
  }

  .carte-equipe__infos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--espace-2) var(--espace-3);
    margin: var(--espace-3) 0 0;
    font-size: var(--taille-sm);
    color: var(--texte-doux);
  }
</style>
