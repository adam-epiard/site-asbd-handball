---
/**
 * En-tête : nom du club et menu principal.
 * Sur téléphone, le menu s'ouvre avec un bouton ; sans JavaScript,
 * il reste simplement affiché. Les sous-menus utilisent <details>,
 * natif et utilisable au clavier.
 */
import { Image } from 'astro:assets';
import { site } from '../config/site';
import { menu } from '../config/navigation';
import logo from '../assets/logo-asbd.png';

const cheminActuel = Astro.url.pathname;
const estActif = (href?: string) => href !== undefined && href === cheminActuel;
---

<header class="entete">
  <div class="conteneur entete__barre">
    <a class="entete__logo" href="/" aria-label={`${site.nom}, accueil`}>
      <Image src={logo} alt="" width={56} height={56} densities={[1, 2]} loading="eager" class="entete__image" />
      <span class="entete__nom" aria-hidden="true">
        <span class="entete__sigle">ASBD Handball</span>
        <span class="entete__ville">La Bruffière</span>
      </span>
    </a>

    <button
      class="entete__bouton"
      type="button"
      aria-expanded="false"
      aria-controls="menu-principal"
      data-bouton-menu
    >
      <span class="entete__burger" aria-hidden="true"></span>
      <span class="entete__bouton-texte">Menu</span>
    </button>

    <nav class="menu" id="menu-principal" aria-label="Menu principal" data-menu>
      <ul class="menu__liste">
        {
          menu.map((lien) => (
            <li class="menu__element">
              {lien.enfants ? (
                <details class="menu__groupe">
                  <summary class="menu__lien">{lien.label}</summary>
                  <ul class="menu__sous-liste">
                    {lien.enfants.map((enfant) => (
                      <li>
                        <a
                          class="menu__sous-lien"
                          href={enfant.href}
                          aria-current={estActif(enfant.href) ? 'page' : undefined}
                        >
                          {enfant.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              ) : (
                <a class="menu__lien" href={lien.href} aria-current={estActif(lien.href) ? 'page' : undefined}>
                  {lien.label}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const bouton = document.querySelector<HTMLButtonElement>('[data-bouton-menu]');
  const nav = document.querySelector<HTMLElement>('[data-menu]');

  if (bouton && nav) {
    const fermer = () => {
      bouton.setAttribute('aria-expanded', 'false');
      nav.classList.remove('menu--ouvert');
    };

    bouton.addEventListener('click', () => {
      const ouvert = bouton.getAttribute('aria-expanded') === 'true';
      bouton.setAttribute('aria-expanded', String(!ouvert));
      nav.classList.toggle('menu--ouvert', !ouvert);
    });

    document.addEventListener('keydown', (evenement) => {
      if (evenement.key === 'Escape' && bouton.getAttribute('aria-expanded') === 'true') {
        fermer();
        bouton.focus();
      }
    });
  }

  // Un seul sous-menu ouvert à la fois, et fermeture au clic en dehors.
  const groupes = document.querySelectorAll<HTMLDetailsElement>('.menu__groupe');
  groupes.forEach((groupe) => {
    groupe.addEventListener('toggle', () => {
      if (groupe.open) {
        groupes.forEach((autre) => {
          if (autre !== groupe) autre.open = false;
        });
      }
    });
  });
  document.addEventListener('click', (evenement) => {
    const cible = evenement.target as Node;
    groupes.forEach((groupe) => {
      if (!groupe.contains(cible)) groupe.open = false;
    });
  });
</script>

<style>
  .entete {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--blanc);
    border-bottom: var(--trait);
  }

  .entete__barre {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--espace-2);
    min-height: 4.5rem;
  }

  .entete__logo {
    display: flex;
    align-items: center;
    gap: var(--espace-3);
    padding-block: var(--espace-2);
    color: var(--noir);
    text-decoration: none;
  }

  .entete__image {
    width: 3.5rem;
    height: 3.5rem;
  }

  .entete__nom {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .entete__sigle {
    font-family: var(--police-titre);
    font-size: 1.625rem;
    font-weight: var(--graisse-titre);
  }

  .entete__ville {
    margin-top: 0.2rem;
    font-size: var(--taille-sm);
    color: var(--texte-doux);
  }

  .entete__bouton {
    display: none;
    align-items: center;
    gap: var(--espace-2);
    min-height: var(--cible-tactile);
    padding: var(--espace-2) var(--espace-4);
    border: 2px solid var(--noir);
    border-radius: var(--rayon-bouton);
    background: transparent;
    color: var(--noir);
    font: inherit;
    font-weight: var(--graisse-gras);
    cursor: pointer;
  }

  .entete__bouton[aria-expanded='true'] {
    background: var(--noir);
    color: var(--blanc);
  }

  .entete__burger,
  .entete__burger::before,
  .entete__burger::after {
    display: block;
    width: 1.1rem;
    height: 2px;
    background: currentColor;
  }

  .entete__burger {
    position: relative;
  }

  .entete__burger::before,
  .entete__burger::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .entete__burger::before {
    top: -6px;
  }

  .entete__burger::after {
    top: 6px;
  }

  .menu {
    width: 100%;
  }

  .menu__liste,
  .menu__sous-liste {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: none;
  }

  .menu__liste {
    display: flex;
    flex-direction: column;
    padding-bottom: var(--espace-4);
  }

  .menu__lien,
  .menu__sous-lien {
    display: block;
    padding: var(--espace-2) 0;
    color: var(--noir);
    font-weight: var(--graisse-moyen);
    text-decoration: none;
    cursor: pointer;
  }

  .menu__lien:hover,
  .menu__sous-lien:hover {
    color: var(--rouge-fonce);
  }

  .menu__lien[aria-current='page'],
  .menu__sous-lien[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--rouge);
    text-decoration-thickness: 3px;
    text-underline-offset: 0.45em;
  }

  .menu__sous-liste {
    padding-left: var(--espace-4);
  }

  /* Téléphone avec JavaScript : menu replié derrière le bouton. */
  @media (max-width: 74.99rem) {
    :global(.js) .entete__bouton {
      display: inline-flex;
    }

    :global(.js) .menu {
      display: none;
    }

    :global(.js) .menu.menu--ouvert {
      display: block;
      border-top: var(--trait);
      padding-top: var(--espace-2);
    }

    .menu__lien,
    .menu__sous-lien {
      min-height: var(--cible-tactile);
      display: flex;
      align-items: center;
      font-size: var(--taille-lg);
    }
  }

  /* Écran large : menu en ligne, sous-menus déroulants. */
  @media (min-width: 75rem) {
    .entete__barre {
      flex-wrap: nowrap;
    }

    .menu {
      width: auto;
    }

    .menu__liste {
      flex-direction: row;
      gap: var(--espace-4);
      padding-bottom: 0;
    }

    .menu__element {
      position: relative;
    }

    .menu__groupe summary {
      list-style: none;
    }

    .menu__groupe summary::-webkit-details-marker {
      display: none;
    }

    .menu__groupe summary::after {
      content: '';
      display: inline-block;
      width: 0.4em;
      height: 0.4em;
      margin-left: 0.4em;
      border-right: 2px solid currentColor;
      border-bottom: 2px solid currentColor;
      transform: translateY(-0.2em) rotate(45deg);
    }

    .menu__sous-liste {
      position: absolute;
      top: calc(100% + var(--espace-2));
      left: calc(-1 * var(--espace-4));
      min-width: 14rem;
      padding: var(--espace-2) var(--espace-4);
      background: var(--blanc);
      border: var(--trait);
      border-radius: var(--rayon);
      box-shadow: 0 12px 32px rgb(0 0 0 / 0.08);
    }
  }
</style>
