---
/**
 * Gabarit commun à toutes les pages : balises meta, en-tête, pied de page.
 * Chaque page fournit un titre et une description uniques (référencement).
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';

interface Props {
  /** Titre de la page, sans le nom du club (ajouté automatiquement). */
  titre: string;
  /** Description unique de la page, 160 caractères au plus. */
  description?: string;
}

const { titre, description = site.description } = Astro.props;

const titreComplet = Astro.url.pathname === '/' ? `${site.nom} : ${titre}` : `${titre} | ${site.nom}`;
const canonique = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    {site.noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.nom} />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0b4f9c" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="lien-evitement" href="#contenu">Aller au contenu</a>
    <Header />
    <main id="contenu">
      <slot />
    </main>
    <Footer />
  </body>
</html>
