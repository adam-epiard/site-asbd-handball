# Configuration Apache de l'hébergement OVH.
# Ce fichier est copié tel quel à la racine du site au build.

# Pages et erreurs
DirectoryIndex index.html
ErrorDocument 404 /404.html
Options -Indexes

# Redirections des anciennes adresses WordPress (301 = définitive)
RedirectMatch 301 ^/evenements/?$ /
RedirectMatch 301 ^/album-photo/?$ /galerie/
RedirectMatch 301 ^/licences-2025-26/?$ /licences/
RedirectMatch 301 ^/u10-mixte/?$ /entrainement/
RedirectMatch 301 ^/equipe-masculine/u19-m/?$ /equipe-masculine/
RedirectMatch 301 ^/(elementor-889|inscription)/?$ /

# Forcer HTTPS : à activer seulement quand le certificat est vérifié
# sur le domaine et sur www (voir Risques dans le dossier de cadrage).
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Cache navigateur : les fichiers de /_astro/ ont un nom unique à chaque build.
# Les autres fichiers (HTML, favicon...) gardent un nom fixe : pas de cache long.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
